# Copy to .env and fill in. The server refuses to start if a required value is missing or still a placeholder.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=postgresql://hub:hub@localhost:5432/campus_hub
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PAYMENT_WEBHOOK_SECRET=change-me-to-another-long-random-string-32-chars

ENV=development
PUBLIC_ORIGIN=https://localhost:8443
COOKIE_SECURE=true

# Optional: leave blank to simulate delivery (messages are logged and marked "simulated" in the outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
